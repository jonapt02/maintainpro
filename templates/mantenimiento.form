{% extends "base.html" %}

{% block title %}Nuevo Mantenimiento{% endblock %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h4><i class="bi bi-tools"></i> Registrar Mantenimiento</h4>
                <small>Máquina: <strong>{{ maquina.nombre }}</strong> ({{ maquina.codigo }})</small>
            </div>
            <div class="card-body">
                <form method="POST">
                    <div class="mb-3">
                        <label class="form-label">Tipo *</label>
                        <select name="tipo" class="form-select" required>
                            <option value="Preventivo">Preventivo</option>
                            <option value="Correctivo">Correctivo</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Técnico *</label>
                        <input type="text" name="tecnico" class="form-control" required placeholder="Nombre del técnico">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Descripción *</label>
                        <textarea name="descripcion" class="form-control" rows="3" required placeholder="¿Qué se hizo?"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Repuestos cambiados</label>
                        <input type="text" name="repuestos" class="form-control" placeholder="Ej: Filtro de aceite, correa, etc.">
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Costo ($)</label>
                                <input type="number" step="0.01" name="costo" class="form-control" placeholder="0.00">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Duración (horas)</label>
                                <input type="number" step="0.5" name="duracion" class="form-control" placeholder="0.0">
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i> Registrar
                    </button>
                    <a href="{{ url_for('detalle_maquina', id=maquina.id) }}" class="btn btn-secondary">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}